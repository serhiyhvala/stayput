{
  "manifest_version": 3,
  "name": "StayPut",
  "version": "0.1.0",
  "description": "GitHub images open in an in-page preview. External links open in a new tab.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ]
    }
  ]
}
